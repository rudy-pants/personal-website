{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "www.rudybanerjee.com", "custom_domain": true },
    { "pattern": "rudybanerjee.com", "custom_domain": true }
  ],
  "env": {
    "preview": {
      "name": "personal-website-preview",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
