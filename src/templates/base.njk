<!doctype html>
<html lang="en" data-view="{{ view }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="only light">
  <meta name="darkreader-lock">
  <meta name="theme-color" content="{{ '#010103' if view == 'home' else '#050c24' }}">
  {%- set fullTitle = (title + " · " + site.name) if title else (site.name) %}
  {%- set desc = description or site.description %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ desc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if title and view == 'post' else 'website' }}">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ desc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/share.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.name }}">
  <link rel="preload" href="/fonts/newsreader-r.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles/site.css">
  <script>
    // Lets the opening animation start hidden. If the sky never starts, show the page anyway.
    document.documentElement.classList.add("js");
    setTimeout(function () {
      if (!document.documentElement.classList.contains("sky-ready")) document.documentElement.classList.remove("js");
    }, 3000);
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <canvas id="sky-fixed" aria-hidden="true"></canvas>
  <div id="probe"></div>
  <header id="top">
    <a id="brand" href="/" data-nav>{{ site.name }}</a>
    <nav aria-label="Main">
      {%- for item in site.nav %}
      <a href="{{ item.url }}" data-nav>{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </header>
  <div id="sky-scrim"></div>
  <div id="scrim"></div>
  <div id="pscrim"></div>
  <main id="main">
{{ content | safe }}
  </main>
  <script type="module" src="/sky/index.js"></script>
</body>
</html>
